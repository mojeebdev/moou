QWEN_KEY=your_key_here
NEXT_PUBLIC_SITE_URL=https://usemoou.xyz

# Your Playbook API key is passed per-request in POST /deploy-prompt as playbook_key (not stored).
# Obtain from Bitget Playbook → Create Agent → sub-account setup

# Firebase Admin (rate limiting + compilation counter)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Base64 salt for IP hashing (generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))")
IP_SALT=your_base64_salt_here

# Public API rate limit per IP per hour (default: 30). Increase on Vercel as usage grows.
# RATE_LIMIT_MAX=30